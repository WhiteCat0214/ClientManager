# Keep Windows line endings for the sources and the build script
*.cpp text eol=crlf
*.h text eol=crlf
*.rc text eol=crlf
*.bat text eol=crlf
*.md text

# The settings file must be UTF-16 LE with a BOM in the working tree (required by the Windows INI API).
# Git stores it as UTF-8 in the repository (so diffs work in GitHub Desktop) and converts it back on checkout.
*.ini text working-tree-encoding=UTF-16LE-BOM eol=crlf
*.ico binary
